{
  "name": "casmate",
  "version": "0.5.0",
  "private": true,
  "description": "Windows向けストリーミング配信支援アプリ",
  "author": "kyokutyou",
  "license": "AGPL-3.0-or-later",
  "main": "dist-electron/main/electron.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "node tools/compatibility-policy.mjs --check && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "node tools/compatibility-policy.mjs --check && node tools/lint.mjs",
    "lint:prototypes": "node tools/lint.mjs --scope=prototypes",
    "test": "node tools/compatibility-policy.mjs --check && node tools/test.mjs",
    "test:prototypes": "vitest run --config vitest.prototypes.config.mts",
    "test:watch": "vitest",
    "build:worker": "dotnet publish src/speech-recognition-worker/CasMate.SpeechRecognition.Worker/CasMate.SpeechRecognition.Worker.csproj -c Release -r win-x64 --self-contained true -o resources/speech-recognition-worker",
    "build:pc-worker": "dotnet publish src/pc-status-worker/CasMate.PcStatus.Worker/CasMate.PcStatus.Worker.csproj -c Release -r win-x64 --self-contained true -o resources/pc-status-worker && node tools/write-pc-worker-fingerprint.mjs",
    "native:prepare": "node tools/prepare-outdoor-native.mjs",
    "test:native": "node tools/build-outdoor-worker.mjs --test",
    "test:native-media": "node tools/test-outdoor-worker.mjs",
    "build:outdoor-worker": "node tools/build-outdoor-worker.mjs",
    "build:obs-style-editor": "vite build --config vite.obs-style-editor.config.mts",
    "build": "node tools/compatibility-policy.mjs --check && vite build && vite build --config vite.direct.config.mts && pnpm build:obs-style-editor && tsc -p tsconfig.main.json && pnpm build:worker && pnpm build:pc-worker && pnpm build:outdoor-worker",
    "start": "electron .",
    "package:win": "pnpm build && electron-builder --win nsis",
    "compatibility:generate": "node tools/compatibility-policy.mjs --generate",
    "compatibility:check": "node tools/compatibility-policy.mjs --check"
  },
  "build": {
    "appId": "jp.casmate.app",
    "productName": "CasMate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "resources/outdoor-worker",
        "to": "resources/outdoor-worker",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/pc-status-worker",
        "to": "resources/pc-status-worker",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "resources/ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/speech-recognition-worker",
        "to": "resources/speech-recognition-worker",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "executableName": "CasMate",
      "artifactName": "CasMate-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "entities": "8.0.0",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "image-size": "^2.0.2",
    "pngjs": "5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
