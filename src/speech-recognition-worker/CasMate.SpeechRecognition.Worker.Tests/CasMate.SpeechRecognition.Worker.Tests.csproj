<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasMate.SpeechRecognition.Worker\CasMate.SpeechRecognition.Worker.csproj" />
    <ProjectReference Include="..\CasMate.SpeechRecognition.ExtractionTestHost\CasMate.SpeechRecognition.ExtractionTestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyExtractionTestHost" AfterTargets="Build">
    <ItemGroup>
      <ExtractionHostFiles Include="../CasMate.SpeechRecognition.ExtractionTestHost/bin/$(Configuration)/net10.0-windows/win-x64/CasMate.SpeechRecognition.ExtractionTestHost.*" Exclude="../CasMate.SpeechRecognition.ExtractionTestHost/bin/$(Configuration)/net10.0-windows/win-x64/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtractionHostFiles)" DestinationFolder="$(OutDir)extraction-test-host" />
  </Target>
</Project>
